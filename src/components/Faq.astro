---
import { faqs } from '../data/resume';
---

<section id="faq">
  <div class="section-head">
    <span class="section-index mono">07</span>
    <h2>Frequently asked</h2>
  </div>

  {faqs.map((f) => (
    <div class="faq-item">
      <div class="faq-q">{f.question}</div>
      <p class="faq-a">{f.answer}</p>
    </div>
  ))}
</section>
