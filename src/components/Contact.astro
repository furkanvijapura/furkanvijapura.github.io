---
import { person } from '../data/resume';
---

<section id="contact">
  <div class="section-head">
    <span class="section-index mono">09</span>
    <h2>Get in touch</h2>
  </div>
  <p>Based in {person.locationFull} ({person.timezone}), open to remote work globally.</p>

  <div class="contact-grid">
    <a class="contact-link" href={`mailto:${person.email}`}><span>Email</span><span class="arrow mono">→</span></a>
    <a class="contact-link" href={`tel:${person.phoneHref}`}><span>{person.phone}</span><span class="arrow mono">→</span></a>
    <a class="contact-link" href="https://www.linkedin.com/in/furkanvijapura" target="_blank" rel="noopener"><span>LinkedIn</span><span class="arrow mono">→</span></a>
    <a class="contact-link" href="https://github.com/furkanvijapura" target="_blank" rel="noopener"><span>GitHub</span><span class="arrow mono">→</span></a>
  </div>
</section>
