---
import { person, heroStats, shippedApps } from '../data/resume';

const stats = heroStats.map((s) =>
  s.label === 'shipped products' ? { ...s, num: String(shippedApps.length) } : s
);
---

<section class="hero" id="about">
  <div class="hero-scene" id="hero-scene" aria-hidden="true">
    <div class="hero-device">
      <div class="hero-device-face">
        <span class="hero-device-notch"></span>
        <span class="hero-device-line w1"></span>
        <span class="hero-device-line w2"></span>
        <span class="hero-device-line w3"></span>
        <span class="hero-device-chip"></span>
      </div>
      <div class="hero-device-edge"></div>
    </div>
    <div class="hero-orbit"></div>
  </div>

  <h1>{person.heroHeadingLine1}<br />{person.heroHeadingLine2} <span class="accent">{person.heroHeadingAccent}</span>.</h1>
  <p class="hero-lede">{person.heroLede}</p>

  <div class="stat-strip" id="stat-strip">
    {stats.map((s) => (
      <div class="stat">
        <span class="num" data-final={s.num}>{s.num}</span>
        <span class="label">{s.label}</span>
      </div>
    ))}
  </div>

  <div class="hero-actions">
    <a class="btn primary" href="#contact">Get in touch</a>
    <a class="btn" href="/furkan-vijapura-resume.pdf" target="_blank">Download resume</a>
    <a class="btn" href="#shipped">See shipped apps</a>
    <a class="btn" href="https://github.com/furkanvijapura" target="_blank" rel="noopener">github.com/furkanvijapura</a>
  </div>
</section>

<script is:inline>
  (function () {
    var scene = document.getElementById('hero-scene');
    if (!scene) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(min-width: 1281px)').matches) return;
    if (window.matchMedia('(hover: none)').matches) return;

    var pending = false, nx = 0, ny = 0;

    function apply() {
      pending = false;
      scene.style.setProperty('--mx', nx.toFixed(3));
      scene.style.setProperty('--my', ny.toFixed(3));
    }

    window.addEventListener(
      'pointermove',
      function (e) {
        // -1..1 relative to viewport centre; transform-only, so no layout work.
        nx = (e.clientX / window.innerWidth) * 2 - 1;
        ny = (e.clientY / window.innerHeight) * 2 - 1;
        if (!pending) {
          pending = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true }
    );
  })();
</script>

<script is:inline>
  (function () {
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    var strip = document.getElementById('stat-strip');
    if (!strip) return;

    function countUp(el) {
      var final = el.getAttribute('data-final') || '';
      var match = final.match(/^(\d+)(.*)$/);
      if (!match) return;
      var target = parseInt(match[1], 10);
      var suffix = match[2] || '';
      var duration = 600;
      var start = null;

      function step(timestamp) {
        if (start === null) start = timestamp;
        var progress = Math.min((timestamp - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.round(eased * target);
        el.textContent = current + suffix;
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = final;
        }
      }
      requestAnimationFrame(step);
    }

    var fired = false;
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !fired) {
            fired = true;
            strip.querySelectorAll('.num').forEach(countUp);
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(strip);
  })();
</script>
