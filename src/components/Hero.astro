---
import { person, heroStats } from '../data/resume';
---

<section class="hero" id="about">
  <h1>{person.heroHeadingLine1}<br />Native code, serverless backends, <span class="accent">and AI wired in</span>.</h1>
  <p class="hero-lede">{person.heroLede}</p>

  <div class="stat-strip">
    {heroStats.map((s) => (
      <div class="stat">
        <span class="num">{s.num}</span>
        <span class="label">{s.label}</span>
      </div>
    ))}
  </div>

  <div class="hero-actions">
    <a class="btn primary" href="#contact">Get in touch</a>
    <a class="btn" href="/furkan-vijapura-resume.pdf" target="_blank">Download resume</a>
    <a class="btn" href="#shipped">See shipped apps</a>
    <a class="btn" href="https://github.com/furkanvijapura" target="_blank" rel="noopener">github.com/furkanvijapura</a>
  </div>
</section>
