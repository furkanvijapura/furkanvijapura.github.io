---
import { education, certifications, skillTiers } from '../data/resume';
---

<section id="background" class="reveal">
  <div class="section-head">
    <span class="section-index mono">05</span>
    <h2>Background</h2>
  </div>

  <div class="two-col">
    <div>
      <h3 style="font-size:1rem;color:var(--text);margin-bottom:10px;">Education</h3>
      <ul class="list-plain">
        {education.map((e) => (
          <li>
            <div class="list-title">{e.title}</div>
            <div class="list-sub">{e.sub}</div>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 style="font-size:1rem;color:var(--text);margin-bottom:10px;">Certifications</h3>
      <ul class="list-plain">
        {certifications.map((c) => (
          <li>
            <div class="list-title">{c.title}</div>
            <div class="list-sub">
              {c.sub}
              {c.certificateUrl && (
                <>
                  {' · '}
                  <a href={c.certificateUrl} target="_blank" rel="noopener noreferrer">View certificate</a>
                </>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <h3 style="font-size:1rem;color:var(--text);margin:32px 0 4px;">Skills</h3>
  {skillTiers.map((t) => (
    <div class="skill-tier">
      <div class="skill-tier-head">
        <span class="skill-tier-name mono">{t.tier}</span>
        <span class="skill-tier-note">{t.note}</span>
      </div>
      <div class="chip-row">
        {t.items.map((skill) => <span class:list={['chip', { 'chip-core': t.tier === 'Core' }]}>{skill}</span>)}
      </div>
    </div>
  ))}
  <p style="margin-top:14px;font-size:0.86rem;">Also builds smaller side projects in Flutter, Node.js, and Vue/Nuxt outside of client work.</p>
</section>
