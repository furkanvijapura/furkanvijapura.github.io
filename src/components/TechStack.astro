---
import {
  techStack,
  integrations,
  aiIntegrations,
  tooling,
  planningTools,
  collaborationTools,
} from '../data/resume';

const groups = [
  { title: 'Languages & platforms', items: techStack },
  { title: 'Integrations', items: integrations },
  { title: 'AI integrations', items: aiIntegrations },
  { title: 'Tooling', items: tooling },
  { title: 'Planning & tracking', items: planningTools },
  { title: 'Design & collaboration', items: collaborationTools },
];
---

<section id="stack" class="reveal">
  <div class="section-head">
    <span class="section-index mono">04</span>
    <h2>Tech stack</h2>
  </div>
  <p>The tools behind everything on this page: native, cross-platform, and cloud.</p>

  {groups.map((g, gi) => (
    <>
      <h3 style={`font-size:1rem;color:var(--text);margin:${gi === 0 ? '0 0 10px' : '28px 0 10px'};`}>
        {g.title}
      </h3>
      <div class="tech-grid">
        {g.items.map((t) => (
          <div class="tech-tile">
            <img src={t.icon} alt="" width="28" height="28" />
            <span class="tech-name">{t.name}</span>
          </div>
        ))}
      </div>
    </>
  ))}
</section>
