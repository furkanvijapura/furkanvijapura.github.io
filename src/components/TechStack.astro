---
import { readFileSync } from 'node:fs';
import { techStack } from '../data/resume';

interface LanguageStat {
  name: string;
  bytes: number;
}
interface SkillsPayload {
  generatedAt: string;
  topLanguages: LanguageStat[];
}

const skills: SkillsPayload = JSON.parse(
  readFileSync(new URL('../../public/assets/data/skills.json', import.meta.url), 'utf-8')
);
const totalBytes = skills.topLanguages.reduce((sum, l) => sum + l.bytes, 0) || 1;
const bytesByLanguage = new Map(skills.topLanguages.map((l) => [l.name, l.bytes]));

const syncedDate = new Date(skills.generatedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section id="stack">
  <div class="section-head">
    <span class="section-index mono">04</span>
    <h2>Tech stack</h2>
  </div>
  <p>The tools behind everything on this page, native, cross-platform, cloud, and AI.</p>

  <div class="tech-grid">
    {techStack.map((t) => {
      const bytes = t.languageKey ? bytesByLanguage.get(t.languageKey) : undefined;
      const pct = bytes != null ? Math.round((bytes / totalBytes) * 100) : null;
      return (
        <div class:list={['tech-tile', { synced: pct != null }]}>
          <img src={t.icon} alt="" width="28" height="28" />
          <span class="tech-name">{t.name}</span>
          {pct != null && <span class="tech-badge">{pct}%</span>}
        </div>
      );
    })}
  </div>

  <div class="sync-note mono">Synced {syncedDate} from both GitHub accounts</div>
</section>
