---
import { techStack, integrations } from '../data/resume';
---

<section id="stack">
  <div class="section-head">
    <span class="section-index mono">04</span>
    <h2>Tech stack</h2>
  </div>
  <p>The tools behind everything on this page, native, cross-platform, cloud, and AI.</p>

  <h3 style="font-size:1rem;color:var(--text);margin-bottom:10px;">Languages &amp; platforms</h3>
  <div class="tech-grid">
    {techStack.map((t) => (
      <div class="tech-tile">
        <img src={t.icon} alt="" width="28" height="28" />
        <span class="tech-name">{t.name}</span>
      </div>
    ))}
  </div>

  <h3 style="font-size:1rem;color:var(--text);margin:28px 0 10px;">Integrations &amp; tooling</h3>
  <div class="tech-grid">
    {integrations.map((t) => (
      <div class="tech-tile">
        <img src={t.icon} alt="" width="28" height="28" />
        <span class="tech-name">{t.name}</span>
      </div>
    ))}
  </div>
</section>
