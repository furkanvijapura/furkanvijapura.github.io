---
import { person, socials } from '../data/resume';

const sections = [
  { href: '#experience', label: 'Experience' },
  { href: '#shipped', label: 'Shipped apps' },
  { href: '#services', label: 'Services' },
  { href: '#stack', label: 'Tech stack' },
  { href: '#activity', label: 'Activity' },
  { href: '#writing', label: 'Writing' },
];
---

<footer class="pro-footer">
  <div class="pro-footer-grid">
    <div class="pro-footer-col">
      <div class="pro-footer-name">{person.name}</div>
      <p>{person.role}, {person.roleLine}. Based in {person.location}, working with teams globally.</p>
      <a class="pro-footer-cta" href={`mailto:${person.email}`}>{person.email}</a>
    </div>

    <div class="pro-footer-col">
      <div class="pro-footer-heading mono">Sections</div>
      <ul class="pro-footer-list">
        {sections.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </div>

    <div class="pro-footer-col">
      <div class="pro-footer-heading mono">Elsewhere</div>
      <ul class="pro-footer-list">
        {socials.map((s) => <li><a href={s.url} target="_blank" rel="me noopener">{s.label}</a></li>)}
      </ul>
    </div>

    <div class="pro-footer-col">
      <div class="pro-footer-heading mono">Status</div>
      <ul class="pro-footer-list">
        <li><span class="mono">{person.buildTag}</span></li>
        <li><span>Activity syncs daily</span></li>
        <li><span>Writing syncs daily</span></li>
        <li><span>Skill signal syncs monthly</span></li>
        <li><a href="/furkan-vijapura-resume.pdf" target="_blank">Resume PDF</a><span>, rebuilt on every deploy</span></li>
        <li><a href="/llms.txt" target="_blank">llms.txt</a> · <a href="https://github.com/furkanvijapura/furkanvijapura.github.io" target="_blank" rel="noopener">view source</a></li>
      </ul>
    </div>
  </div>

  <div class="pro-footer-bottom">
    <span>© 2026 {person.name}</span>
    <span>Built with Astro, TypeScript, and real data. No stock copy, no invented metrics.</span>
  </div>
</footer>
