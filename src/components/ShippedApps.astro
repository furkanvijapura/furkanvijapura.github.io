---
import { shippedApps } from '../data/resume';
---

<section id="shipped">
  <div class="section-head">
    <span class="section-index mono">02</span>
    <h2>Shipped, live, verifiable</h2>
  </div>
  <p style="margin-bottom:22px;">
    Four apps currently live on the App Store from the Wve Labs era, each verifiable on its own listing.
  </p>

  <div class="apps-grid">
    {shippedApps.map((app) => (
      <a class="app-card" href={app.url} target="_blank" rel="noopener">
        <img class="app-icon" src={app.icon} alt={`${app.name} app icon`} width="64" height="64" />
        <div>
          <div class="app-name">{app.name}</div>
          <div class="app-meta">
            <span>{app.category}</span>
            <span>{app.developer}</span>
          </div>
          <p class="app-desc">{app.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>
