---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface WritingItem {
  title: string;
  url: string;
  source: 'DEV' | 'Medium';
  publishedAt: string;
  description: string | null;
}
interface WritingPayload {
  generatedAt: string;
  items: WritingItem[];
}

// Resolved from the project root (process.cwd()), not import.meta.url: the
// bundler's chunk output location is an implementation detail that has
// changed between Astro major versions, but the project root is stable.
const writing: WritingPayload = JSON.parse(
  readFileSync(join(process.cwd(), 'public/assets/data/writing.json'), 'utf-8')
);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<section id="writing">
  <div class="section-head">
    <span class="section-index mono">07</span>
    <h2>Writing</h2>
  </div>
  <p>Synced daily from Medium and DEV.to.</p>
  <ul class="list-plain" id="writing-list">
    {writing.items.length === 0 && <li><div class="list-sub">Nothing published recently.</div></li>}
    {writing.items.map((item) => (
      <li>
        <a class="list-title" href={item.url} target="_blank" rel="noopener" style="text-decoration:none;">{item.title}</a>
        {item.description && <p style="margin:4px 0 0;font-size:0.88rem;">{item.description}</p>}
        <div class="list-sub">{item.source} · {formatDate(item.publishedAt)}</div>
      </li>
    ))}
  </ul>
</section>
