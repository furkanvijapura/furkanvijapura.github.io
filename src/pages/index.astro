---
import BaseLayout from '../layouts/BaseLayout.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import ShippedApps from '../components/ShippedApps.astro';
import Services from '../components/Services.astro';
import TechStack from '../components/TechStack.astro';
import Background from '../components/Background.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Furkan Vijapura · Senior Mobile Engineer, Native & Serverless AI';
const description =
  "Furkan Vijapura is a Senior Mobile Engineer in India with nine years shipping 30+ apps across iOS, watchOS, iPadOS, and Android: native iOS, cross-platform Flutter, and the serverless mobile backends behind them, across five companies, with four public case studies including The Daily Pour and the Ovvy real estate photography platform. Now applying AI and agentic tooling (Claude Code, MCP, GitHub Actions) to mobile engineering.";
---

<BaseLayout title={title} description={description}>
  <div class="shell">
    <Rail />
    <main>
      <div class="doc">
        <Hero />
        <Experience />
        <ShippedApps />
        <Services />
        <TechStack />
        <Background />
        <Faq />
        <Contact />
      </div>
      <Footer />
    </main>
  </div>
</BaseLayout>
