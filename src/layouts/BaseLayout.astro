---
import '../styles/global.css';
import { person, socials, faqs, shippedApps } from '../data/resume';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/img/avatar.jpg', Astro.site);
const site = Astro.site?.origin ?? '';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  jobTitle: `${person.role} (${person.roleLine})`,
  worksFor: { '@type': 'Organization', name: 'Wve Labs' },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'IN',
  },
  email: `mailto:${person.email}`,
  telephone: person.phoneHref,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Suresh Gyan Vihar University' },
    { '@type': 'CollegeOrUniversity', name: 'Ganpat University' },
  ],
  knowsAbout: [
    'iOS Development', 'Swift', 'SwiftUI', 'SwiftData', 'Flutter', 'Dart',
    'Firebase', 'AWS Amplify', 'Fastlane', 'REST APIs', 'GitHub Actions',
    'Mobile App Architecture',
  ],
  sameAs: socials.map((s) => s.url),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const appsJsonLd = shippedApps.map((app) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  url: app.url,
  applicationCategory: app.category,
  operatingSystem: app.playStoreUrl ? 'iOS, Android' : 'iOS',
  description: app.description,
  author: { '@type': 'Person', name: person.name },
  ...(app.playStoreUrl ? { sameAs: [app.playStoreUrl] } : {}),
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#0d1015" />
  <meta name="color-scheme" content="dark" />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="profile:first_name" content="Furkan" />
  <meta property="profile:last_name" content="Vijapura" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
  {appsJsonLd.map((app) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(app)} />
  ))}
</head>
<body>
  <slot />

  {/* Shown only on paper. File > Print can't be intercepted the way Ctrl+P is,
      so rather than printing a dark page, print a card pointing at the PDF. */}
  <div class="print-card" aria-hidden="true">
    <h1>{person.name}</h1>
    <p class="print-role">{person.role} · {person.roleLine}</p>
    <p class="print-note">
      This page is designed for screen. The formatted, up-to-date resume is a PDF:
    </p>
    <p class="print-url">{site}{person.resumePath}</p>
    <p class="print-contact">
      {person.email} · {person.phone} · {person.location}<br />
      {site}
    </p>
  </div>

  <div class="copy-toast" id="copy-toast" role="status" aria-live="polite">
    <span id="copy-toast-msg">Copying's disabled here.</span>
    <a href="#contact" id="copy-toast-link">Get in touch instead →</a>
    <button type="button" id="copy-toast-close" aria-label="Dismiss">×</button>
  </div>

  <script is:inline define:vars={{ resumePath: person.resumePath }}>
    (function () {
      var toast = document.getElementById('copy-toast');
      if (!toast) return;
      var msgEl = document.getElementById('copy-toast-msg');
      var linkEl = document.getElementById('copy-toast-link');
      var hideTimer;

      function showToast(message, withLink) {
        msgEl.textContent = message;
        linkEl.hidden = !withLink;
        toast.classList.add('visible');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hideToast, 5000);
      }
      function hideToast() {
        toast.classList.remove('visible');
      }

      document.addEventListener('copy', function (e) {
        e.preventDefault();
        if (e.clipboardData) {
          e.clipboardData.setData('text/plain', 'Contact Furkan Vijapura: furkanvijapura@gmail.com');
        }
        showToast("Copying's disabled here.", true);
      });
      document.addEventListener('cut', function (e) {
        e.preventDefault();
        showToast("Copying's disabled here.", true);
      });

      // Ctrl/Cmd+P hands over the PDF resume rather than printing the page —
      // this is a dark-themed site, so the printed page is not what anyone
      // reaching for print actually wants.
      document.addEventListener('keydown', function (e) {
        if ((e.key || '').toLowerCase() !== 'p') return;
        if (!(e.metaKey || e.ctrlKey) || e.altKey || e.shiftKey) return;
        e.preventDefault();

        var a = document.createElement('a');
        a.href = resumePath;
        a.download = '';
        document.body.appendChild(a);
        a.click();
        a.remove();

        showToast('Downloading the PDF resume instead of printing.', false);
      });

      var closeBtn = document.getElementById('copy-toast-close');
      if (closeBtn) closeBtn.addEventListener('click', hideToast);
    })();
  </script>

  <script is:inline>
    (function () {
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion || !('IntersectionObserver' in window)) return;

      var targets = document.querySelectorAll('.reveal');
      if (!targets.length) return;

      document.documentElement.classList.add('will-reveal');

      function reveal(el) {
        el.classList.add('revealed');
        observer.unobserve(el);
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            // Also reveal anything already scrolled past: an anchor jump or a
            // restored scroll position skips sections, and a section left at
            // opacity 0 would never come back.
            if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
              reveal(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      targets.forEach(function (t) { observer.observe(t); });

      // Safety net: never leave content hidden, whatever the observer does.
      setTimeout(function () {
        document.querySelectorAll('.reveal:not(.revealed)').forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight) reveal(el);
        });
      }, 2000);
    })();
  </script>
</body>
</html>
